{
  "name": "facturacio-ortopedia",
  "productName": "Facturacio Ortopedia",
  "version": "1.0.0",
  "description": "Facturació — Ortopèdia",
  "author": "aalsiusferrer123-ui",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "dist:linux": "electron-builder --linux AppImage --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.aalsiusferrer.facturacio-ortopedia",
    "productName": "Facturacio Ortopedia",
    "files": ["main.js", "app/**/*"],
    "directories": { "buildResources": "build", "output": "dist" },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Facturacio-Ortopedia-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Facturació Ortopèdia"
    },
    "mac": {
      "target": { "target": "dmg", "arch": ["universal"] },
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "artifactName": "Facturacio-Ortopedia-Mac.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "artifactName": "Facturacio-Ortopedia-Linux.${ext}"
    }
  }
}
